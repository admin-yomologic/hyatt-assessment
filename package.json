{
  "name": "support-tickets-assessment",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "install:all": "npm install && npm --prefix api install && npm --prefix web install",
    "dev": "concurrently -n api,web -c yellow,cyan \"npm --prefix api run dev\" \"npm --prefix web run dev\"",
    "dev:api": "npm --prefix api run dev",
    "dev:web": "npm --prefix web run dev",
    "build:web": "npm --prefix web run build",
    "preview:web": "npm --prefix web run preview",
    "lint:web": "npm --prefix web run lint"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@tanstack/react-query": "^5.83.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.525.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "@types/aws-lambda": "^8.10.152",
    "@types/node": "^24.0.15",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^10.0.3",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.8.3",
    "vite": "^7.0.0"
  }
}
